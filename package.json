{
  "name": "mathtutor",
  "private": true,
  "version": "0.1.0",
  "description": "MathTutor — 数学成长引擎：整体认知 / 弱点诊断 / 直观理解 / 能力养成 / 融会贯通",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @mathtutor/e2e test:e2e",
    "test:engine": "cd services/video-engine && .venv/bin/python -m pytest -q",
    "golden:check": "python3 scripts/golden_check.py",
    "golden:eval": "python3 scripts/golden_eval.py",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast",
    "dev:server": "pnpm --filter @mathtutor/server dev",
    "dev:web": "pnpm --filter frontend dev"
  }
}
