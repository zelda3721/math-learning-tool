{
  "name": "@mathtutor/subject-math",
  "version": "0.1.0",
  "description": "数学学科包：判卷器（数值/表达式/多段）、验证器、视觉词汇",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
