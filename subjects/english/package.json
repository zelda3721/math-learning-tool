{
  "name": "@mathtutor/subject-english",
  "version": "0.1.0",
  "description": "英语学科包（骨架）：词汇卡题型 + 参考答案判卷器",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
