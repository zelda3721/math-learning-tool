  },
  "files": ["dist", "content"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mathtutor/core": "workspace:*",
    "@mathtutor/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6",
    "vitest": "^2"
  }
}
