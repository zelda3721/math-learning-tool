{
  "name": "@mathtutor/explainer-web",
  "version": "0.1.0",
  "description": "模式 A Web 播放器：SceneSpec 校验 / 逐拍折叠 / SVG 渲染（零运行时依赖，原生 DOM 受控组件）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mathtutor/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6",
    "vitest": "^2"
  }
}
