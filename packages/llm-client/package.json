{
  "name": "@mathtutor/llm-client",
  "version": "0.1.0",
  "description": "OpenAI-compatible streaming LLM client for local small models (LMStudio / vLLM / Ollama / DeepSeek), ported from the video-engine Python provider",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6",
    "vitest": "^2"
  }
}
